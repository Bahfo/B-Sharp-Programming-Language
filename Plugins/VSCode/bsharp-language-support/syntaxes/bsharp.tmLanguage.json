{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "B_Sharp",
  "scopeName": "source.bsharp",
  "patterns": [
    { "include": "#comments" },
    { "include": "#macros" },
    { "include": "#strings" },
    { "include": "#builtins" },
    { "include": "#keywords" },
    { "include": "#array-types" },
    { "include": "#types" },
    { "include": "#error-types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#delimiters" },
    { "include": "#functions" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.bsharp",
          "match": "//.*$"
        },
        {
          "name": "comment.block.bsharp",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "macros": {
      "patterns": [
        {
          "begin": "^\\s*!\\s*[a-zA-Z_][a-zA-Z0-9_]*",
          "beginCaptures": {
            "0": { "name": "keyword.macro.bsharp" }
          },
          "end": "$",
          "patterns": [
            {
              "name": "support.function.macro.bsharp",
              "match": "\\b(enforce|precision|default)\\b"
            },
            {
              "name": "constant.numeric.integer.bsharp",
              "match": "\\b[0-9]+\\b"
            },
            {
              "name": "comment.line.macro.bsharp",
              "match": "//.*$"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.bsharp",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.bsharp",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.bsharp",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.bsharp",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.bsharp",
          "match": "\\b(write|writeln|format|read|readln|is_String|is_Number|is_Empty|is_Bool|to_Number|to_String|time)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.bsharp",
          "match": "\\b(if|elif|else|then|do|for|while|try|catch|using|return|break|continue|pass|pragma)\\b"
        },
        {
          "name": "keyword.operator.logical.bsharp",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.type.function.bsharp",
          "match": "\\b(fn|function)\\b"
        },
        {
          "name": "storage.type.variable.bsharp",
          "match": "\\b(var|const|struct)\\b"
        }
      ]
    },
    "array-types": {
      "patterns": [
        {
          "name": "storage.type.array.bsharp",
          "match": "\\b(Number|String|Bool|Empty)\\[\\]\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.bsharp",
          "match": "\\b(Bool|Number|String|List|Function|Tuple|Inf|NaN|Empty)\\b"
        }
      ]
    },
    "error-types": {
      "patterns": [
        {
          "name": "support.class.exception.bsharp",
          "match": "\\b(B_SharpSyntaxError|RunTimeError|AssignmentError|ModificationError|ComparisonError|BSharpMathError|ShadowingError|Error)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.numeric.bsharp",
          "match": "\\b(inf|nan|Inf|NaN)\\b"
        },
        {
          "name": "constant.language.boolean.bsharp",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.bsharp",
          "match": "\\b(none)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.bsharp",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.bsharp",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.bsharp",
          "match": "\\+\\+|--|\\*\\*|//|<<|>>>?|\\+|\\-|\\*|/|%"
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.separator.delimiter.bsharp",
          "match": ",|;|:"
        },
        {
          "name": "punctuation.section.parens.bsharp",
          "match": "\\(|\\)"
        },
        {
          "name": "punctuation.section.braces.bsharp",
          "match": "\\{|\\}"
        },
        {
          "name": "punctuation.section.brackets.bsharp",
          "match": "\\[|\\]"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.bsharp" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.bsharp",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.float.bsharp",
          "match": "\\b[0-9]+[eE][+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.bsharp",
          "match": "\\b[0-9]+\\b"
        }
      ]
    }
  }
}