{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "B_Sharp",
  "scopeName": "source.bsharp",
  "patterns": [
    { "include": "#comments" },
    { "include": "#caller-macros" },
    { "include": "#preproc" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#builtins" },
    { "include": "#keywords" },
    { "include": "#cast" },
    { "include": "#array-types" },
    { "include": "#types" },
    { "include": "#error-types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#delimiters" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.bsharp",
          "match": "//.*$"
        },
        {
          "name": "comment.block.bsharp",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "caller-macros": {
      "patterns": [
        {
          "name": "keyword.macro.bsharp",
          "match": "!\\s*pragma\\b"
        },
        {
          "match": "(!\\s*pragma)\\s+(enforce|precision)\\b(?:\\s+(default|\\d+))?",
          "captures": {
            "1": { "name": "keyword.macro.bsharp" },
            "2": { "name": "support.function.macro.bsharp" },
            "3": { "name": "constant.numeric.integer.bsharp" }
          }
        },
        {
          "name": "invalid.illegal.macro.bsharp",
          "match": "!(?!=)\\s*[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "invalid.illegal.bsharp",
          "match": "!(?!=)"
        }
      ]
    },
    "preproc": {
      "patterns": [
        {
          "name": "keyword.preproc.bsharp",
          "match": "\\[#\\s*(ifver|ifdef|define|endif)\\s*\\]"
        },
        {
          "name": "constant.other.platform.bsharp",
          "match": "\\b(__GNU_LINUX|__NT_KERNEL|__DARWIN)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.bsharp",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.bsharp",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "constant.character.bsharp",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.bsharp",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.bsharp",
          "match": "\\b(__writeln|__readln|__is_String|__is_Numeric|__is_Short|__is_Single|__is_Integer|__is_Long|__is_Float|__is_Double|__is_Empty|__is_Bool|__is_Char|__to_Long|__to_Double|__to_String|__format|__write|__read|__time__)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.bsharp",
          "match": "\\b(if|elif|else|then|do|for|while|try|catch|using|return|break|continue|pass)\\b"
        },
        {
          "name": "keyword.operator.logical.bsharp",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.type.function.bsharp",
          "match": "\\b(fn|function)\\b"
        },
        {
          "name": "storage.type.variable.bsharp",
          "match": "\\b(var|const|struct)\\b"
        }
      ]
    },
    "cast": {
      "patterns": [
        {
          "match": "\\b(cast)(?=\\s*\\()",
          "captures": {
            "1": { "name": "support.function.cast.bsharp" }
          }
        }
      ]
    },
    "array-types": {
      "patterns": [
        {
          "name": "storage.type.array.bsharp",
          "match": "\\b(Short|Single|Integer|Long|Float|Double|Char|String|Bool|Empty)(\\[\\])+"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.bsharp",
          "match": "\\b(Bool|Short|Single|Integer|Long|Float|Double|Char|String|Empty|List|Tuple|Function|Inf|NaN)\\b"
        }
      ]
    },
    "error-types": {
      "patterns": [
        {
          "name": "support.class.exception.bsharp",
          "match": "\\b(B_SharpSyntaxError|RunTimeError|AssignmentError|ModificationError|ComparisonError|BSharpMathError|ShadowingError|Error)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.numeric.bsharp",
          "match": "\\b(inf|nan)\\b"
        },
        {
          "name": "constant.language.boolean.bsharp",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.bsharp",
          "match": "\\b(none)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.bsharp",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?[fFdD]?\\b|\\b[0-9]+[eE][+-]?[0-9]+[fFdD]?\\b|\\b[0-9]+[fFdD]\\b"
        },
        {
          "name": "constant.numeric.integer.bsharp",
          "match": "\\b[0-9]+[lLisSbB]?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "invalid.illegal.bsharp",
          "match": "\\*\\*"
        },
        {
          "name": "keyword.operator.comparison.bsharp",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.bsharp",
          "match": "="
        },
        {
          "name": "keyword.operator.arrow.bsharp",
          "match": "->"
        },
        {
          "name": "keyword.operator.increment.bsharp",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.arithmetic.bsharp",
          "match": "\\+|-|\\*|/|%|~|\\^"
        },
        {
          "name": "keyword.operator.range.bsharp",
          "match": "\\.\\.\\.|\\.\\.|\\."
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.separator.delimiter.bsharp",
          "match": ",|;|:"
        },
        {
          "name": "punctuation.section.parens.bsharp",
          "match": "\\(|\\)"
        },
        {
          "name": "punctuation.section.braces.bsharp",
          "match": "\\{|\\}"
        },
        {
          "name": "punctuation.section.brackets.bsharp",
          "match": "\\[|\\]"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.bsharp" }
          }
        }
      ]
    }
  }
}
