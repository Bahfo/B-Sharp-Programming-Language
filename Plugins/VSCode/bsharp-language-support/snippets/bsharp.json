{
  "B# if": {
    "prefix": "if",
    "body": ["if ${1:condition} {", "\t${0}", "}"],
    "description": "B# if statement"
  },
  "B# elif": {
    "prefix": "elif",
    "body": "elif ${1:condition} {",
    "description": "B# elif branch"
  },
  "B# else": {
    "prefix": "else",
    "body": ["else {", "\t${0}", "}"],
    "description": "B# else branch"
  },
  "B# then": {
    "prefix": "then",
    "body": "then ${1:statement}",
    "description": "B# single-line branch: if cond then stmt"
  },
  "B# for": {
    "prefix": "for",
    "body": ["for (var ${1:i} = ${2:0}; ${1:i} < ${3:n}; ${1:i}++) {", "\t${0}", "}"],
    "description": "B# C-style for loop"
  },
  "B# while": {
    "prefix": "while",
    "body": ["while ${1:condition} {", "\t${0}", "}"],
    "description": "B# while loop"
  },
  "B# do..while": {
    "prefix": "do",
    "body": ["do {", "\t${0}", "} while (${1:condition})"],
    "description": "B# do..while loop"
  },
  "B# try/catch": {
    "prefix": "try",
    "body": ["try {", "\t${1}", "} catch (${2:Error} ${3:e}) {", "\t${0}", "}"],
    "description": "B# try/catch block"
  },
  "B# catch": {
    "prefix": "catch",
    "body": ["catch (${1:Error} ${2:e}) {", "\t${0}", "}"],
    "description": "B# catch handler"
  },
  "B# return": {
    "prefix": "return",
    "body": "return ${1:value}",
    "description": "B# return statement"
  },
  "B# break": {
    "prefix": "break",
    "body": "break",
    "description": "B# break statement"
  },
  "B# continue": {
