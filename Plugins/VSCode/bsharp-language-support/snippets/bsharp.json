  "B# [#ifver] block": {
    "prefix": ["[#ifver", "[#ifver]"],
    "body": ["[#ifver] ${1|__GNU_LINUX,__NT_KERNEL,__DARWIN|}", "${0}", "[#endif]"],
    "description": "B# platform-conditional block"
  },
  "B# [#ifdef]": {
    "prefix": ["[#ifdef", "[#ifdef]"],
    "body": "[#ifdef] ${1:name}",
    "description": "B# predefined macro"
  },
  "B# [#define]": {
    "prefix": ["[#define", "[#define]"],
    "body": "[#define] ${1:name} ${2:value}",
