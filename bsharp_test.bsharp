var z = 10;

z = "Hello";

fn display(z) {
    return z;
}

fn add(x, y) -> Number {
    return x + y
}

fn sub(x , y) -> Number {
    var z = x - y;
    return z;
}

var add_shadow = add;
add_shadow(3, 2);

fn function_overloading(x, y) -> Number {
    var value = x(5, 6);
    return value + y;
}

function_overloading(add, 10);

display(z)