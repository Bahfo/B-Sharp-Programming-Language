// Simple matrix multiplication code implemented in B-Sharp.
// Dosen't measure for edge cases, but it shows that B-Sharp is 
// completed with needed features for later upgrades.

!pragma enforce

fn make_zeros(num_rows : Number, num_cols : Number) -> Number[] {
    var row : Number[] = []
    var output_matrix : Number[] = []

    for (var i : Number = 0; i < num_rows; i++) {
        row[i] = 0;
    }

    for (var j : Number = 0; j < num_cols; j++) {
        output_matrix[j] = row
    }

    return output_matrix
}

fn multiply_matrices(x : Number[], y : Number[]) -> Number[] {
    var rowsX : Number = x.length;
    var rowsY : Number = y.length;
    var colsX : Number = if (x[0].type == "Number") then 1 else {x[0].length};
    var colsY : Number = y[0].length;

    var matrix_output : Number[] = make_zeros(colsX, rowsY)

    for (var i : Number = 0; i < rowsX; i++) {
        for (var j : Number = 0; j < colsY; j++) {
            var sum : Number = 0;
            for (var k : Number = 0; k < colsX; k++) {
                sum = sum + x[i][k] * y[k][j];
            }
            matrix_output[i][j] = sum;
        }
    }

    return matrix_output;
}

var x : Number[] = [2, 3]
var y : Number[] = [[1,2],[0,0]]
writeln(multiply_matrices(x, y))
