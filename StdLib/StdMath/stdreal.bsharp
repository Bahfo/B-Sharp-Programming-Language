// Constant values inside stdreal module
const PI_VALUE : Number = 3.14159
const PI_VALUE_3Digits : Number = 3.141
const TAU_VALUE : Number = 6.28318
const TAU_VALUE_3Digits : Number = 6.283
const EULER_NUMBER : Number = 2.71828
const EULER_NUMBER_3Digits : Number = 2.718
const SQRT2 : Number = 1.41421
const SQRT2_3Digits = 1.414
const SQRT3 : Number = 1.73205
const SQRT3_3Digits = 1.732

// Absolute value function of a number. Returns a number.
fn abs(x : Number) -> Number {
    if (x > 0) {
        return x;
    } elif (x == 0) {
        return 0;
    } else {
        return x * -1;
    }
}

// Cubic Root function of a number. Returns a number.
fn cbrt(x : Number) -> Number {
    return x^(0.3);
}

