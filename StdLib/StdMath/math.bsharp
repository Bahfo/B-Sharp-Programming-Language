[#ifver] __GNU_LINUX

[#endif]

// The following abstraction layer happens only on NT_KERNEL
[#ifver] __NT_KERNEL

[#endif]

// The following abstraction layer happens only on UNX_DARWIN
[#ifver] __DARWIN

